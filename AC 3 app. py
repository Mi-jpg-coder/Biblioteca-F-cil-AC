from flask import Flask, request, jsonify, send_from_directory
import mysql.connector
from mysql.connector import Error
import os

app = Flask(__name__)

# Caminho da pasta frontend
PASTA_FRONTEND = os.path.abspath(
    os.path.join(os.path.dirname(__file__), "..", "frontend")
)


# CONEXÃO COM O MYSQL
def conectar():
    return mysql.connector.connect(
        host="localhost",
        user="root",
        password="1234",
        database="biblioteca",
        port=3306
    )


# CRIAR TABELA
def criar_tabela():
    conexao = conectar()
    cursor = conexao.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS livros (
            Id INT AUTO_INCREMENT PRIMARY KEY,
            Titulo VARCHAR(150) NOT NULL,
            Autor VARCHAR(150) NOT NULL,
            Ano INT NULL
        )
    """)

    conexao.commit()
    cursor.close()
    conexao.close()


# ABRIR A PÁGINA PRINCIPAL
@app.route("/")
def inicio():
    return send_from_directory(PASTA_FRONTEND, "index.html")


# ABRIR O CSS
@app.route("/style.css")
def estilo():
    return send_from_directory(PASTA_FRONTEND, "style.css")


# LISTAR TODOS OS LIVROS
@app.route("/livros", methods=["GET"])
def listar_livros():
    try:
        conexao = conectar()
        cursor = conexao.cursor(dictionary=True)

        cursor.execute("""
            SELECT
                Id AS id,
                Titulo AS titulo,
                Autor AS autor,
                Ano AS ano
            FROM livros
            ORDER BY Id DESC
        """)

        livros = cursor.fetchall()

        cursor.close()
        conexao.close()

        return jsonify(livros)

    except Error as erro:
        return jsonify({"erro": str(erro)}), 500


# PESQUISAR LIVROS POR TÍTULO OU AUTOR
@app.route("/pesquisar", methods=["GET"])
def pesquisar_livros():
    termo = request.args.get("q", "").strip()

    try:
        conexao = conectar()
        cursor = conexao.cursor(dictionary=True)

        cursor.execute("""
            SELECT
                Id AS id,
                Titulo AS titulo,
                Autor AS autor,
                Ano AS ano
            FROM livros
            WHERE Titulo LIKE %s
               OR Autor LIKE %s
            ORDER BY Id DESC
        """, (f"%{termo}%", f"%{termo}%"))

        livros = cursor.fetchall()

        cursor.close()
        conexao.close()

        return jsonify(livros)

    except Error as erro:
        return jsonify({"erro": str(erro)}), 500


# CADASTRAR LIVRO
@app.route("/livros", methods=["POST"])
def cadastrar_livro():
    dados = request.get_json(silent=True) or {}

    titulo = dados.get("titulo")
    autor = dados.get("autor")
    ano = dados.get("ano")

    if not titulo or not titulo.strip():
        return jsonify({"erro": "Informe o título do livro."}), 400

    if not autor or not autor.strip():
        return jsonify({"erro": "Informe o autor do livro."}), 400

    try:
        conexao = conectar()
        cursor = conexao.cursor()

        cursor.execute("""
            INSERT INTO livros (Titulo, Autor, Ano)
            VALUES (%s, %s, %s)
        """, (titulo.strip(), autor.strip(), ano))

        conexao.commit()

        cursor.close()
        conexao.close()

        return jsonify({
            "mensagem": "Livro cadastrado com sucesso!"
        }), 201

    except Error as erro:
        return jsonify({"erro": str(erro)}), 500


# EDITAR LIVRO
@app.route("/livros/<int:livro_id>", methods=["PUT"])
def editar_livro(livro_id):
    dados = request.get_json(silent=True) or {}

    titulo = dados.get("titulo")
    autor = dados.get("autor")
    ano = dados.get("ano")

    if not titulo or not titulo.strip():
        return jsonify({"erro": "Informe o título do livro."}), 400

    if not autor or not autor.strip():
        return jsonify({"erro": "Informe o autor do livro."}), 400

    try:
        conexao = conectar()
        cursor = conexao.cursor()

        cursor.execute("""
            UPDATE livros
            SET Titulo = %s,
                Autor = %s,
                Ano = %s
            WHERE Id = %s
        """, (titulo.strip(), autor.strip(), ano, livro_id))

        conexao.commit()

        if cursor.rowcount == 0:
            cursor.close()
            conexao.close()
            return jsonify({"erro": "Livro não encontrado."}), 404

        cursor.close()
        conexao.close()

        return jsonify({
            "mensagem": "Livro atualizado com sucesso!"
        })

    except Error as erro:
        return jsonify({"erro": str(erro)}), 500


# EXCLUIR LIVRO
@app.route("/livros/<int:livro_id>", methods=["DELETE"])
def excluir_livro(livro_id):
    try:
        conexao = conectar()
        cursor = conexao.cursor()

        cursor.execute("""
            DELETE FROM livros
            WHERE Id = %s
        """, (livro_id,))

        conexao.commit()

        if cursor.rowcount == 0:
            cursor.close()
            conexao.close()
            return jsonify({"erro": "Livro não encontrado."}), 404

        cursor.close()
        conexao.close()

        return jsonify({
            "mensagem": "Livro excluído com sucesso!"
        })

    except Error as erro:
        return jsonify({"erro": str(erro)}), 500


