# FUNÇÃO PARA LISTAR LIVROS COM DISPONIBILIDADE
def consultar_livros(termo=None):
    conexao = conectar()
    cursor = conexao.cursor(dictionary=True)

    try:
        sql = """
            SELECT
                l.Id AS id,
                l.Titulo AS titulo,
                l.Autor AS autor,
                l.Ano AS ano,
                CASE
                    WHEN EXISTS (
                        SELECT 1
                        FROM emprestimos e
                        WHERE e.livro_id = l.Id
                        AND e.data_devolucao IS NULL
                    )
                    THEN 'Emprestado'
                    ELSE 'Disponível'
                END AS disponibilidade
            FROM livros l
        """

        parametros = ()

        if termo:
            sql += """
                WHERE l.Titulo LIKE %s
                   OR l.Autor LIKE %s
            """
            parametros = (f"%{termo}%", f"%{termo}%")

        sql += " ORDER BY l.Id DESC"

        cursor.execute(sql, parametros)
        return cursor.fetchall()

    finally:
        cursor.close()
        conexao.close()


# LISTAR TODOS OS LIVROS
